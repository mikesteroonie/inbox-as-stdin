# Written by `harness init`. Keys never live in harness.yaml.
AGENTMAIL_API_KEY=am_xxx              # org-scoped key; used by `harness init` only
AGENTMAIL_API_KEY_BACKEND=am_xxx      # per-inbox key, one per agent (AGENTMAIL_API_KEY_<AGENT>)
ANTHROPIC_API_KEY=sk-ant-xxx          # or an existing Claude Code login
