{
  "name": "inbox-as-stdin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Email as the interface to a pod of coding agents. The inbox is stdin.",
  "bin": {
    "harness": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-prompts.mjs",
    "harness": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.237",
    "@inquirer/prompts": "^8.6.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agentmail": "^0.5.20",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
